<mujoco model="upper_body_follow">
  <compiler angle="radian"/>

  <asset>
    <material name="robot_mat" rgba="0.2 0.5 0.8 1"/>
    <material name="ground_mat" rgba="0.8 0.8 0.8 1"/>
    <material name="target_mat" rgba="1 0 0 1"/>
    <material name="ee_mat" rgba="0 1 0 0.8"/>
  </asset>

  <worldbody>
    <geom name="floor" size="5 5 0.1" type="plane" material="ground_mat"/>
    <camera name="camera_front" pos="0.3 -1.1 0.6" quat="0.5 0.5 0.5 0.5"/>
    <camera name="camera_side" pos="1 0 0.8" quat="0 0 0 1"/>
    <body name="table">
      <geom size="0.5 0.5 0.05" pos="0 0 0.05" type="box" rgba="0.6 0.6 0.6 1"/>
    </body>
    <body name="robot_base" pos="0 -0.5 0.05">
      <joint name="base_x" pos="0 0 0" axis="1 0 0" type="slide" limited="true" range="-0.2 0.2"/>
      <joint name="base_y" pos="0 0 0" axis="0 1 0" type="slide" limited="true" range="-0.2 0.2"/>
      <geom size="0.1 0.1 0.05" type="box" rgba="0.2 0.2 0.2 1"/>
      <body name="torso" pos="0 0 0.1">
        <geom size="0.08 0.06 0.16" type="box" rgba="0.3 0.4 0.6 1"/>
        <body name="shoulder" pos="0 0 0.18">
          <joint name="shoulder_yaw" pos="0 0 0" axis="0 0 1" range="-1.5708 1.5708"/>
          <geom size="0.04 0.07" pos="0.07 0 0" quat="0.707107 0 -0.707107 0" type="capsule" rgba="0.2 0.6 0.8 1"/>
          <body name="upper_arm" pos="0.14 0 0">
            <joint name="elbow_pitch" pos="0 0 0" axis="0 1 0" range="-2.35619 2.35619"/>
            <geom size="0.035 0.1" pos="0.1 0 0" quat="0.707107 0 -0.707107 0" type="capsule" rgba="0.2 0.6 0.8 1"/>
            <body name="forearm" pos="0.2 0 0">
              <geom size="0.05" rgba="0.8 0.6 0.2 1"/>
              <site name="ee" pos="0 0 0" size="0.03" rgba="0 1 0 0.8"/>
            </body>
          </body>
        </body>
      </body>
    </body>
    <body name="target" pos="0.45 0 0.35">
      <geom size="0.05" material="target_mat"/>
      <site name="target_site" pos="0 0 0" size="0.05" rgba="1 0 0 0.4"/>
    </body>
  </worldbody>

  <actuator>
    <general name="act_shoulder_yaw" joint="shoulder_yaw" ctrlrange="-1 1" biastype="affine" gainprm="80" biasprm="0 -80"/>
    <general name="act_elbow_pitch" joint="elbow_pitch" ctrlrange="-1 1" biastype="affine" gainprm="80" biasprm="0 -80"/>
  </actuator>
</mujoco>
